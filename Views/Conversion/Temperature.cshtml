    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Temperature";

}

<h2 id="title" class="mb-3 mt-5">Temperature</h2>

@if ((bool)ViewData["Converted"] == false)
{

<form class="form" id="for" target="_self">
    <div class="form-group row d-flex justify-content-center"> 
        <div class="col-sm-3 text-center"> 
            <label for="tempToConvert">Enter the temperature to convert</label>
            <input type="numeric" class="form-control text-center" id="tempToConvert" required placeholder="Temperature" name="data">
        </div>
    </div>
    <div class="form-group row d-flex justify-content-center">
        <div class="col-sm-3 text-center"> 
            <label for="a" class="mt-2">Unit to convert from</label>
            <select class="form-control text-center" name="unit1">
                <option value="F">Fahrenheit (°F)</option>
                <option value="C">Celsius (°C)</option>
                <option value="K">Kelvin (K)</option>
                
            </select>
            <label for="a" class="mt-2">Unit to convert to</label>
            <select class="form-control text-center" name="unit2">
                <option value="F">Fahrenheit (°F)</option>
                <option value="C">Celsius (°C)</option>
                <option value="K">Kelvin (K)</option>
            </select>
            <button class="btn btn-primary mt-3 mb-3">Convert</button>
        </div>
    </div>
</form>
}
else
{
    ViewData["Converted"] = false;
    <div id="res">
        <h2>Result of your calculation</h2>
        <h3>@ViewData["Data"]@ViewData["Unit1"] = @ViewData["Result"]@ViewData["Unit2"]</h3>
        <form target="_self">
            <button class="btn btn-primary">Reset</button>
        </form>
    </div>
}