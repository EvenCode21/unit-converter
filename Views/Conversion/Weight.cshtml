    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Weight";

}

<h2 id="title" class="mb-3 mt-5">Weight</h2>

@if ((bool)ViewData["Converted"] == false)
{

<form class="form" id="for" target="_self">
    <div class="form-group row d-flex justify-content-center"> 
        <div class="col-sm-3 text-center"> 
            <label for="weightToConvert">Enter the weight to convert</label>
            <input type="numeric" class="form-control text-center" id="weightToConvert" required placeholder="Weight" name="data">
        </div>
    </div>
    <div class="form-group row d-flex justify-content-center">
        <div class="col-sm-3 text-center"> 
            <label for="a" class="mt-2">Unit to convert from</label>
            <select class="form-control text-center" name="unit1">
                <option value="milligram">Milligram</option>
                <option value="gram">gram</option>
                <option value="kilogram">Kilogram</option>
                <option value="ounce">ounce</option>
                <option value="pound">Pound</option>

            </select>
            <label for="a" class="mt-2">Unit to convert to</label>
            <select class="form-control text-center" name="unit2">
                <option value="miligram">Milligram</option>
                <option value="gram">gram</option>
                <option value="kilogram">Kilogram</option>
                <option value="ounce">ounce</option>
                <option value="pound">Pound</option>
            </select>
            <button class="btn btn-primary mt-3 mb-3">Convert</button>
        </div>
    </div>
</form>
}
else
{
    ViewData["Converted"] = false;
    <div id="res">
        <h2>Result of your calculation</h2>
        <h3>@ViewData["Data"]@ViewData["Unit1"] = @ViewData["Result"]@ViewData["Unit2"]</h3>
        <form target="_self">
            <button class="btn btn-primary">Reset</button>
        </form>
    </div>
}